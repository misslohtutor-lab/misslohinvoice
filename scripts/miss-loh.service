[Unit]
Description=Miss Loh Tutoring School
After=network.target

[Service]
Type=simple
User=felix
Environment=TZ=America/Toronto
WorkingDirectory=/home/felix/projects/tutorschedule
# Rebuild before every start so `systemctl restart` never serves stale code.
# (Fails the start if the build breaks, instead of serving the old bundle.)
ExecStartPre=/usr/bin/npm run build
ExecStart=/usr/bin/npx next start -p 3100 -H 0.0.0.0
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target